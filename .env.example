# BASE_URL — required. Public URL of this service used to generate QR codes.
# Example (local): http://localhost:3000
# Example (Railway): https://your-app.up.railway.app
# The server will refuse to start if this is missing.
BASE_URL=http://localhost:3000

# HOST_PASSWORD — required. Password for the host admin panel.
# Never commit the real value. Set in Railway dashboard for production.
HOST_PASSWORD=changeme

# SESSION_SECRET — required. Secret key for signing session cookies.
# Generate with: openssl rand -hex 32
# Never commit the real value.
SESSION_SECRET=replace-with-64-char-hex-string

# PORT — optional. Defaults to 3000.
# PORT=3000

# NODE_ENV — optional. Set to 'production' on Railway for secure cookies.
# NODE_ENV=production

# DATA_PATH — optional. Directory for SQLite file. Defaults to /data.
# Use ./data for local development.
DATA_PATH=./data
